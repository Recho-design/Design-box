{
  "schema": {
    "version": 10
  },
  "suites": {
    "platform-source": [
      "packages/platform/src/",
      "packages/platform/package.json",
      "packages/platform/esbuild.config.mjs",
      "packages/platform/tsconfig.json",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      ".github/workflows/ci.yml",
      ".github/config/runners.json"
    ],
    "convergence-control": [
      ".github/config/convergence.json",
      ".github/config/postinstall.json",
      ".github/config/scopes.json",
      ".github/config/runners.json",
      ".github/scripts/convergence.py",
      ".github/scripts/postinstall.py",
      ".github/scripts/scopes.py",
      ".github/scripts/runners.py",
      ".github/scripts/handoff.py",
      ".github/scripts/lib/config.py",
      ".github/scripts/lib/github.py",
      ".github/scripts/lib/r2.py",
      ".github/scripts/lib/workload_products.py",
      ".github/actions/configure-ci-parallelism/",
      ".github/actions/setup-workspace/",
      ".github/workflows/ci.yml",
      ".github/workflows/convergence.atom.yml"
    ],
    "workspace-install": [
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "scripts/postinstall.mjs",
      ".github/config/postinstall.json",
      ".github/scripts/postinstall.py",
      ".github/actions/configure-ci-parallelism/",
      ".github/actions/setup-workspace/",
      ".github/workflows/ci.yml"
    ]
  },
  "workflows": {
    "ci": {
      "policy": "ci-v2",
      "workloads": {
        "platform_build": {
          "success": {
            "[build] packages/platform": [
              "[build] Platform public package"
            ]
          },
          "inputs": [
            "suite://platform-source"
          ],
          "runnerClass": "workspace_unit",
          "products": "manifest",
          "reusable": true
        },
        "static_gate": {
          "inputs": [
            "*"
          ],
          "runnerClass": "control",
          "products": "none",
          "reusable": false
        },
        "preflight": {
          "inputs": [
            "*"
          ],
          "runnerClass": "general_medium",
          "products": "none",
          "reusable": false,
          "postinstallIntent": "workspace"
        }
      }
    }
  }
}
